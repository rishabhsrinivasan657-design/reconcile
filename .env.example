# Copy to .env and adjust if needed. Every variable used anywhere is listed here.

# Postgres (docker compose defaults)
DATABASE_URL=postgresql://reconcile:reconcile@localhost:5432/reconcile
# Integration tests run against a separate database; tests that need it are skipped if unset.
DATABASE_URL_TEST=postgresql://reconcile:reconcile@localhost:5432/reconcile_test

# Optional host port overrides for docker compose
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# LLM (M3). Keys go ONLY in your local .env: never in chat, git, or logs.
LLM_PROVIDER=gemini
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# Limits (defaults per provider: Gemini free 10/min, 250/day; Groq free 8000 tokens/min)
# LLM_RPM=10
# LLM_RPD=250
# LLM_TPM=8000
# LLM_TPD=200000
# Hard spend cap for paid providers, USD
# LLM_BUDGET_USD=4
# LLM_CACHE_DIR=.cache/llm

# API + worker (M4)
# REDIS_URL=redis://localhost:6379
# STORAGE_DIR=storage
# API_PORT=3001
# Days to wait for a missing document before reporting it
# MISSING_DOC_GRACE_DAYS=7
# How tricky lines are paired: text | llm | hybrid (default; chosen by the M4 eval)
# FUZZY_STRATEGY=hybrid
# Demo without an API key or quota: replay the recorded answers for the test documents
# LLM_MODE=replay
# LLM_ANSWER_CACHE_DIR=evals/cache

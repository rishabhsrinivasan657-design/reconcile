# Copy to .env and adjust if needed. Every variable used anywhere is listed here.

# Postgres (docker compose defaults)
DATABASE_URL=postgresql://reconcile:reconcile@localhost:5432/reconcile
# Integration tests run against a separate database; tests that need it are skipped if unset.
DATABASE_URL_TEST=postgresql://reconcile:reconcile@localhost:5432/reconcile_test

# Optional host port overrides for docker compose
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# LLM (M3). Keys go ONLY in your local .env: never in chat, git, or logs.
LLM_PROVIDER=groq
LLM_MODEL_EXTRACT=qwen/qwen3.8-27b
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# Limits (defaults per provider; Groq free tier: 8000 tokens/min, 200000/day)
# LLM_RPM=30
# LLM_RPD=1000
# LLM_TPM=8000
# LLM_TPD=200000
# Hard spend cap for paid providers, USD
# LLM_BUDGET_USD=4
# LLM_CACHE_DIR=.cache/llm

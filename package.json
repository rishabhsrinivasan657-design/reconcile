{
  "name": "reconcile",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @reconcile/web test:e2e",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:diagrams": "tsx scripts/render-diagrams.ts",
    "postinstall": "pnpm --filter @reconcile/db exec prisma generate",
    "db:generate": "pnpm --filter @reconcile/db exec prisma generate",
    "db:migrate": "pnpm --filter @reconcile/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @reconcile/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @reconcile/db exec prisma db seed",
    "db:reset": "pnpm --filter @reconcile/db exec prisma migrate reset --force",
    "generate": "tsx packages/generator/src/cli.ts",
    "generate:ci": "tsx packages/generator/src/cli.ts --ci",
    "generate:samples": "tsx packages/generator/src/samples.ts",
    "eval": "tsx evals/src/cli.ts",
    "extract": "tsx packages/extraction/src/cli.ts",
    "eval:record": "tsx evals/src/cli.ts --stage all --live",
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"pnpm --filter @reconcile/api dev\" \"pnpm --filter @reconcile/worker dev\" \"pnpm --filter @reconcile/web dev\"",
    "dev:demo": "LLM_MODE=replay LLM_ANSWER_CACHE_DIR=evals/cache MISSING_DOC_GRACE_DAYS=0 pnpm dev",
    "mcp": "node packages/mcp/bin/reconcile-mcp.mjs",
    "deploy:up": "tsx scripts/deploy.ts up",
    "deploy:down": "tsx scripts/deploy.ts down",
    "deploy:smoke": "tsx scripts/deploy.ts smoke",
    "deploy:leftovers": "tsx scripts/deploy.ts leftovers",
    "dev:api": "pnpm --filter @reconcile/api dev",
    "dev:worker": "pnpm --filter @reconcile/worker dev",
    "dev:web": "pnpm --filter @reconcile/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
